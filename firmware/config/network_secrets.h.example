// Copy this file to network_secrets.h and replace the placeholders.
// network_secrets.h is ignored by Git and should never contain committed keys.
#define MIMI_WIFI_SSID "your-wifi-ssid"
#define MIMI_WIFI_PASSWORD "your-wifi-password"

// Use the Mac/PC LAN address running agent/, not 127.0.0.1.
#define MIMI_AGENT_HOST "192.168.1.100"
#define MIMI_AGENT_PORT 8765
#define MIMI_AGENT_PATH "/"
#define MIMI_DEVICE_ID "mimi-c3-01"
