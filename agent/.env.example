# Mimi Agent server
MIMI_AGENT_HOST=0.0.0.0
MIMI_AGENT_PORT=8765
MIMI_LOG_LEVEL=INFO

# Volcengine Ark streaming LLM. ARK_API_KEY is different from the TTS key.
ARK_API_KEY=
# 填写当前方舟账号已开通的模型名或推理接入点 ID。
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_TIMEOUT_SECONDS=8
ARK_TEMPERATURE=0.7
ARK_MAX_TOKENS=24
# Number of completed user/Mimi interaction turns kept in each device session.
ARK_CONTEXT_TURNS=10
ARK_SERVICE_TIER=

# Volcengine / Doubao TTS V3
VOLCENGINE_API_KEY=
VOLCENGINE_RESOURCE_ID=
VOLCENGINE_VOICE_TYPE=
# Used by the persistent Agent runtime for streaming text and PCM output.
VOLCENGINE_TTS_BIDIRECTIONAL_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# Optional. Leave empty unless the selected voice/resource requires a model override.
VOLCENGINE_TTS_MODEL=
VOLCENGINE_TTS_TIMEOUT_SECONDS=30
MIMI_SPEECH_FIRST_AUDIO_TIMEOUT_SECONDS=8

# Device audio contract. The ESP32 audio player will consume raw PCM frames.
MIMI_AUDIO_SAMPLE_RATE=16000
MIMI_AUDIO_CHANNELS=1
MIMI_AUDIO_SAMPLE_WIDTH=2

MIMI_LOG_DIR=logs
MIMI_LOG_MAX_BYTES=10485760
MIMI_LOG_BACKUP_COUNT=5
MIMI_SPEECH_DEFAULT_COOLDOWN_MS=2500
MIMI_SPEECH_DIZZY_COOLDOWN_MS=5000
